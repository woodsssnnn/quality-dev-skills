{
  "id": "secret-leaks",
  "version": "1.0.0",
  "description": "密钥/凭据泄漏检查：拦截把密码、令牌、私钥硬编码进源码或配置的写入。",
  "appliesTo": {
    "extensions": [".js", ".jsx", ".ts", ".tsx", ".py", ".java", ".go", ".rb", ".php", ".sh", ".ps1", ".cmd", ".bat", ".json", ".yml", ".yaml", ".toml", ".env", ".ini", ".conf", ".cfg", ".properties", ".xml", ".md", ".txt", ".pem", ".key", ".crt", ".sql"]
  },
  "rules": [
    {
      "id": "SEC-001",
      "severity": "block",
      "pattern": "(password|passwd|secret|api[_-]?key|access[_-]?key|private[_-]?key)\\s*[:=]\\s*[\"'][^\"'\\s]{8,}[\"']",
      "flags": "i",
      "message": "疑似硬编码凭据（密码/密钥类赋值）。凭据应来自环境变量或密钥管理，不能进源码。若确为测试用占位值，请改名为明显的 placeholder 并收入测试夹具目录。"
    },
    {
      "id": "SEC-002",
      "severity": "block",
      "pattern": "-----BEGIN (RSA |EC |OPENSSH |PGP )?PRIVATE KEY-----",
      "message": "疑似私钥文件内容被写入源码。私钥绝不能入库，请立即从文件移除，并检查是否已泄漏（必要时轮换密钥）。"
    },
    {
      "id": "SEC-003",
      "severity": "block",
      "pattern": "(mysql|postgres(ql)?|mongodb(\\+srv)?|redis|amqp)://[^\\s\"']*:[^\\s\"'/@]{4,}@",
      "flags": "i",
      "message": "数据库/中间件连接串内嵌明文密码。连接串应从环境变量注入，密码不能硬编码。"
    },
    {
      "id": "SEC-004",
      "severity": "warn",
      "pattern": "(Authorization|X-Api-Key)\\s*[:=]\\s*[\"'](Bearer\\s+)?[A-Za-z0-9_\\-.]{20,}[\"']",
      "flags": "i",
      "message": "疑似硬编码 API 令牌（Authorization/X-Api-Key）。请确认是否为真实令牌；真实令牌应改为运行时注入。"
    }
  ]
}
